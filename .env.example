# Zemlo Frontend — environment contract
# Copy to .env.local and fill in the values. NEXT_PUBLIC_* vars are exposed
# to the browser — never put secrets in them.

# ── Server-only ──────────────────────────────────────────────────────────────
# Base URL of the Zemlo NestJS backend (no trailing slash).
API_BASE_URL=http://localhost:3000

# "true" shows the built-in demo catalog when the real catalog is empty or
# unreachable. Keep OFF ("false") in production.
DEMO_CATALOG_ENABLED=false

# ── Build-time ───────────────────────────────────────────────────────────────
# OpenAPI spec used by `npm run api:generate` (Orval).
ORVAL_API_SPEC_URL=http://localhost:3000/api-json

# ── Client-exposed (NEXT_PUBLIC_*) ───────────────────────────────────────────
# Canonical site URL — used for SEO metadata and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Stripe publishable key (pk_test_... in development). Required for checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App/market defaults.
NEXT_PUBLIC_APP_NAME=Zemlo
NEXT_PUBLIC_DEFAULT_MARKET=de
NEXT_PUBLIC_APP_COUNTRY=DE
NEXT_PUBLIC_APP_CURRENCY=EUR
NEXT_PUBLIC_APP_LOCALE=de-DE
